# ==============================================================================
# POTFOLIOO Backend Environment Configuration
# ==============================================================================
# NOTE: Copy this file to .env and configure your secret values.
# NEVER commit .env to version control or expose API_SECRET_KEY to frontend code.
# ==============================================================================

# Server Environment & Port
PORT=3001
NODE_ENV=development

# Database Configuration (SQLite database path)
DATABASE_PATH=./data/potfolioo.db

# Backend Secret Key (used for secure server-to-server or authenticated sync)
# Generate a strong 32+ character random string for production
API_SECRET_KEY=potfolioo_dev_secret_change_in_production_9f8d7c6b5a4

# Allowed CORS Origins (comma-separated URLs for frontend client access)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info

# ==============================================================================
# FRONTEND PUBLIC CONFIGURATION (Safe to expose to browser)
# Only variables prefixed with VITE_ are bundled into client-side code by Vite.
# ==============================================================================
VITE_API_URL=http://localhost:3001/api

# Supabase Cloud Database Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
